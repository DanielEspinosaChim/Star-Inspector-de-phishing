# Variables de entorno del servicio ML (Flask). No hay carga automática de
# .env: en producción las define la plataforma; en local, exportarlas.

# Ruta al modelo precargado (absoluta, o relativa a backend/ml-service/)
MODEL_DIR=../../models/bert_phishing
# 127.0.0.1 en local; en producción, la IP/interfaz de la red privada. Nunca pública.
ML_HOST=127.0.0.1
ML_PORT=5000
# Producción corre en CPU
ML_DEVICE=cpu
TORCH_NUM_THREADS=2
WAITRESS_THREADS=2
# Deben coincidir con el entrenamiento (notebook 04)
MAX_LEN=128
MAX_CHARS=1000
MAX_BATCH=32
MAX_BODY_CHARS=20000
MAX_SUBJECT_CHARS=1000
LOG_LEVEL=INFO
