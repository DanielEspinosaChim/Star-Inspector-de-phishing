# Copiar a .env y completar. .env nunca se sube al repositorio.

# production por defecto. Usar development SOLO en local (expone Swagger en /docs)
NODE_ENV=production
PORT=3000

# Servicio ML (Flask). En producción, la dirección en la red privada.
ML_SERVICE_URL=http://127.0.0.1:5000
ML_TIMEOUT_MS=10000

# Obligatoria (mín. 16 caracteres). Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY=

# Rate limit por IP para /predict*
THROTTLE_LIMIT=60
THROTTLE_TTL_MS=60000

# Orígenes permitidos separados por coma; vacío = CORS deshabilitado
CORS_ORIGINS=
# true si el gateway corre detrás de un proxy/load balancer (IP real del cliente)
TRUST_PROXY=false
